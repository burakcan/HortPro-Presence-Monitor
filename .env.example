# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Optional: Polling interval in milliseconds (default: 120000 = 2 minutes)
POLL_INTERVAL_MS=120000

# Optional: Only poll during these hours (24h format, Berlin timezone)
# Default: 7:00 - 18:00
POLL_START_HOUR=7
POLL_END_HOUR=18

# Optional: Timezone for time display (default: Europe/Berlin)
TIMEZONE=Europe/Berlin
